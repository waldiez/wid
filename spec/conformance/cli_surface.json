{
  "description": "Shared CLI-surface conformance: the flag matrix, defaults table, and error behavior that all six implementations re-implement by hand. Driven by tools/check_cli_surface.py against every real CLI. 'emit' cases must exit 0 and every stdout line must match the shape implied by params; 'reject' cases must exit nonzero with a diagnostic on stderr and no crash artifact (traceback/panic) — exit_code pins the exact code per the shared contract (2 = usage error, 1 = operational/verification failure; see spec/quick-usage.md 'Exit codes'); 'parity' cases must exit 0 and produce byte-identical (JSON-normalized) output in every implementation; 'infinite' cases must still be running after run_seconds and have emitted at least min_lines shape-conformant lines.",
  "defaults": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" },
  "emit": [
    { "name": "flag-next-defaults", "args": ["next"], "lines": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-next-defaults", "args": ["A=next"], "lines": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "flag-next-overrides", "args": ["next", "--W", "7", "--Z", "0"], "lines": 1,
      "params": { "W": 7, "Z": 0, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-next-overrides", "args": ["A=next", "W=7", "Z=0", "T=ms"], "lines": 1,
      "params": { "W": 7, "Z": 0, "time_unit": "ms", "kind": "wid" } },
    { "name": "flag-next-ms", "args": ["next", "--time-unit", "ms"], "lines": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "ms", "kind": "wid" } },
    { "name": "canonical-next-m-shorthand", "args": ["A=next", "M=true"], "lines": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "ms", "kind": "wid" } },
    { "name": "flag-next-hlc", "args": ["next", "--kind", "hlc", "--node", "n_1"], "lines": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "hlc", "node": "n_1" } },
    { "name": "flag-stream-count", "args": ["stream", "--count", "3"], "lines": 3,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-stream-count", "args": ["A=stream", "N=3"], "lines": 3,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-stateless", "args": ["A=next", "E=stateless"], "lines": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-stream-explicit-L", "args": ["A=stream", "N=2", "L=1"], "lines": 2,
      "min_seconds": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-empty-string-value", "args": ["A=next", "D="], "lines": 1,
      "comment": "Empty values for string keys are accepted everywhere (D= means 'use the default dir'); one parser rejecting KEY= while five accept it is surface drift.",
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-stream-I-auto", "args": ["A=stream", "N=2", "I=auto"], "lines": 2,
      "comment": "Explicit I=auto disables the harness's I=sh pin, so the sh implementation's default delegation path (sh -> python when a python runtime exists) is exercised instead of only its native parser.",
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } }
  ],
  "reject": [
    { "name": "no-args", "args": [], "exit_code": 2 },
    { "name": "flag-W-too-large", "args": ["next", "--W", "19"], "exit_code": 2 },
    { "name": "flag-W-zero", "args": ["next", "--W", "0"], "exit_code": 2 },
    { "name": "flag-Z-too-large", "args": ["next", "--Z", "65"], "exit_code": 2 },
    { "name": "flag-W-not-integer", "args": ["next", "--W", "2+2"], "exit_code": 2 },
    { "name": "flag-bad-time-unit", "args": ["next", "--time-unit", "min"], "exit_code": 2 },
    { "name": "flag-missing-value", "args": ["next", "--W"], "exit_code": 2 },
    { "name": "flag-unknown", "args": ["next", "--frobnicate"], "exit_code": 2 },
    { "name": "flag-json-not-allowed", "args": ["next", "--json"], "exit_code": 2,
      "comment": "--json belongs to parse/healthcheck only; accepting (and silently ignoring) it elsewhere is surface drift." },
    { "name": "flag-bad-kind", "args": ["next", "--kind", "banana"], "exit_code": 2 },
    { "name": "flag-bad-hlc-node", "args": ["next", "--kind", "hlc", "--node", "bad.node"], "exit_code": 2 },
    { "name": "flag-stream-count-not-integer", "args": ["stream", "--count", "x"], "exit_code": 2 },
    { "name": "flag-validate-bad-time-unit", "exit_code": 2,
      "args": ["validate", "20260217T143052.0000Z-a3f91c", "--time-unit", "moo"] },
    { "name": "flag-validate-W-zero", "exit_code": 2,
      "comment": "Out-of-range W on validate/parse is a usage error (2), not 'invalid id' (1).",
      "args": ["validate", "20260217T143052.0000Z-a3f91c", "--W", "0"] },
    { "name": "flag-validate-invalid-id-exit-1", "exit_code": 1, "allow_empty_stderr": true,
      "comment": "An id that fails validation is an operational outcome: exact exit 1 everywhere. The 'false' verdict on stdout is the diagnostic, so stderr may legitimately be empty.",
      "args": ["validate", "not-a-wid"] },
    { "name": "flag-validate-unknown-flag", "exit_code": 2,
      "args": ["validate", "20260217T143052.0000Z-a3f91c", "--bogus", "x"] },
    { "name": "flag-parse-bad-kind", "exit_code": 2,
      "args": ["parse", "20260217T143052.0000Z-a3f91c", "--kind", "banana"] },
    { "name": "flag-stream-no-private-extras", "args": ["stream", "--format", "jsonl"], "exit_code": 2 },
    { "name": "canonical-sign-missing-key-file", "exit_code": 1,
      "comment": "A missing key file is an operational failure (1); a missing KEY= parameter would be a usage error (2).",
      "args": ["A=sign", "KEY=/nonexistent-wid-key.pem", "WID=20260217T143052.0000Z-a3f91c"] },
    { "name": "canonical-sign-missing-key-param", "exit_code": 2,
      "args": ["A=sign", "WID=20260217T143052.0000Z-a3f91c"] },
    { "name": "canonical-bad-time-unit", "args": ["A=next", "T=min"], "exit_code": 2 },
    { "name": "canonical-empty-W", "args": ["A=next", "W="], "exit_code": 2 },
    { "name": "canonical-W-too-large", "args": ["A=next", "W=19"], "exit_code": 2 },
    { "name": "canonical-unknown-action", "args": ["A=nonexistent"], "exit_code": 2 },
    { "name": "canonical-unknown-key", "args": ["A=next", "X=1"], "exit_code": 2 },
    { "name": "validate-missing-id", "args": ["validate"], "exit_code": 2 },
    { "name": "wotp-verify-wrong-code-exit-1", "exit_code": 1,
      "comment": "Verification *outcomes* must exit 1 in every implementation (the real OTP for this secret/WID is 463179). exit_code pins the exact code: scripts distinguish 'verification failed' (1) from 'usage error' (2).",
      "args": ["A=w-otp", "MODE=verify", "KEY=cli-surface-secret", "WID=20200101T000000.0000Z-a3f91c", "CODE=000000", "MAX_AGE_SEC=0", "MAX_FUTURE_SEC=0"] },
    { "name": "wotp-verify-stale-exit-1", "exit_code": 1,
      "comment": "A WID older than MAX_AGE_SEC is a verification outcome, not a usage error: exact exit 1 everywhere.",
      "args": ["A=w-otp", "MODE=verify", "KEY=cli-surface-secret", "WID=20200101T000000.0000Z-a3f91c", "CODE=000000", "MAX_AGE_SEC=60"] },
    { "name": "wotp-verify-malformed-wid-exit-1", "exit_code": 1,
      "comment": "A WID whose timestamp cannot be extracted for the freshness window is also a verification outcome: exact exit 1 everywhere.",
      "args": ["A=w-otp", "MODE=verify", "KEY=cli-surface-secret", "WID=not-a-wid", "CODE=000000", "MAX_AGE_SEC=60"] }
  ],
  "parity": [
    { "name": "wotp-deterministic",
      "args": ["A=w-otp", "MODE=gen", "KEY=parity-secret", "WID=20260217T143052.0000Z-a3f91c"] },
    { "name": "wotp-key-containing-equals",
      "args": ["A=w-otp", "MODE=gen", "KEY=abc=def", "WID=20260217T143052.0000Z-a3f91c"] },
    { "name": "wotp-key-base64ish-trailing-equals",
      "args": ["A=w-otp", "MODE=gen", "KEY=c2VjcmV0PT0=", "WID=20260217T143052.0000Z-a3f91c"] }
  ],
  "infinite": [
    { "name": "flag-stream-count-0", "args": ["stream", "--count", "0"],
      "run_seconds": 1.5, "min_lines": 10,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-stream-N0", "args": ["A=stream", "N=0"],
      "run_seconds": 1.5, "min_lines": 10,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } }
  ]
}
