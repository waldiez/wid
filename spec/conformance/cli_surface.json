{
  "description": "Shared CLI-surface conformance: the flag matrix, defaults table, and error behavior that all six implementations re-implement by hand. Driven by tools/check_cli_surface.py against every real CLI. 'emit' cases must exit 0 and every stdout line must match the shape implied by params; 'reject' cases must exit nonzero with a diagnostic on stderr and no crash artifact (traceback/panic).",
  "defaults": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" },
  "emit": [
    { "name": "flag-next-defaults", "args": ["next"], "lines": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-next-defaults", "args": ["A=next"], "lines": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "flag-next-overrides", "args": ["next", "--W", "7", "--Z", "0"], "lines": 1,
      "params": { "W": 7, "Z": 0, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-next-overrides", "args": ["A=next", "W=7", "Z=0", "T=ms"], "lines": 1,
      "params": { "W": 7, "Z": 0, "time_unit": "ms", "kind": "wid" } },
    { "name": "flag-next-ms", "args": ["next", "--time-unit", "ms"], "lines": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "ms", "kind": "wid" } },
    { "name": "flag-next-hlc", "args": ["next", "--kind", "hlc", "--node", "n_1"], "lines": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "hlc", "node": "n_1" } },
    { "name": "flag-stream-count", "args": ["stream", "--count", "3"], "lines": 3,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-stream-count", "args": ["A=stream", "N=3"], "lines": 3,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-stateless", "args": ["A=next", "E=stateless"], "lines": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } },
    { "name": "canonical-stream-explicit-L", "args": ["A=stream", "N=2", "L=1"], "lines": 2,
      "min_seconds": 1,
      "params": { "W": 4, "Z": 6, "time_unit": "sec", "kind": "wid" } }
  ],
  "reject": [
    { "name": "flag-W-too-large", "args": ["next", "--W", "19"] },
    { "name": "flag-W-zero", "args": ["next", "--W", "0"] },
    { "name": "flag-Z-too-large", "args": ["next", "--Z", "65"] },
    { "name": "flag-W-not-integer", "args": ["next", "--W", "2+2"] },
    { "name": "flag-bad-time-unit", "args": ["next", "--time-unit", "min"] },
    { "name": "flag-missing-value", "args": ["next", "--W"] },
    { "name": "flag-unknown", "args": ["next", "--frobnicate"] },
    { "name": "flag-bad-kind", "args": ["next", "--kind", "banana"] },
    { "name": "flag-bad-hlc-node", "args": ["next", "--kind", "hlc", "--node", "bad.node"] },
    { "name": "flag-stream-count-not-integer", "args": ["stream", "--count", "x"] },
    { "name": "canonical-bad-time-unit", "args": ["A=next", "T=min"] },
    { "name": "canonical-empty-W", "args": ["A=next", "W="] },
    { "name": "canonical-W-too-large", "args": ["A=next", "W=19"] },
    { "name": "canonical-unknown-action", "args": ["A=nonexistent"] },
    { "name": "canonical-unknown-key", "args": ["A=next", "X=1"] },
    { "name": "validate-missing-id", "args": ["validate"] }
  ]
}
