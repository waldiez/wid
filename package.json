{
  "name": "@waldiez/wid",
  "version": "1.0.0",
  "description": "WID — time-ordered, collision-resistant identifier",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "wid-ts": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "dist/",
    "typescript/src/"
  ],
  "scripts": {
    "build": "tsup --config typescript/tsup.config.ts",
    "test": "vitest run --config typescript/vitest.config.ts",
    "lint": "eslint typescript/src typescript/test --ext .ts --max-warnings 0",
    "typecheck": "tsc -p typescript/tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "all": "npm run check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/waldiez/wid.git"
  },
  "homepage": "https://waldiez.github.io/wid",
  "license": "MIT",
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.57.1",
    "@rollup/rollup-darwin-x64": "^4.57.1",
    "@rollup/rollup-linux-arm64-gnu": "^4.57.1",
    "@rollup/rollup-linux-x64-gnu": "^4.57.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
